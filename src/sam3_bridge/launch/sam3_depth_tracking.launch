<launch>
  <!--
    object_name_bridgeはSAM3の生出力を /sam3/raw/... にpublishする。
    object_tracking_by_using_depthが深度追跡後の結果を従来トピックへpublishする。
  -->

  <node
    pkg="sam3_bridge"
    exec="object_name_bridge.py"
    name="object_name_bridge"
    output="screen">

    <param name="grpc_host" value="localhost" />
    <param name="grpc_port" value="50051" />
    <param name="grpc_timeout" value="2.0" />
    <param name="jpeg_quality" value="75" />
    <param name="max_width" value="640" />
    <param name="max_height" value="480" />

    <param name="head_topic"
           value="/hsrb/head_rgbd_sensor/rgb/image_rect_color" />
    <param name="hand_topic"
           value="/hsrb/hand_camera/image_raw" />
    <param name="switch_topic" value="/sam3/switch" />

    <!-- head側は深度追跡ノードへ渡すraw出力に変更 -->
    <param name="head_mask_topic"
           value="/sam3/raw/mask" />
    <param name="head_overlay_topic"
           value="/sam3/raw/overlay" />
    <param name="head_centroid_topic"
           value="/sam3/raw/mask/centroid" />
    <param name="head_object_list_topic"
           value="/sam3/raw/object_list" />

    <!-- hand側は深度がないため従来どおり -->
    <param name="hand_mask_topic"
           value="/sam3/hand/mask" />
    <param name="hand_overlay_topic"
           value="/sam3/hand/overlay" />
    <param name="hand_centroid_topic"
           value="/sam3/hand/mask/centroid" />
    <param name="hand_object_list_topic"
           value="/sam3/hand/object_list" />

    <param name="default_prompt" value="object" />
  </node>

  <node
    pkg="sam3_bridge"
    exec="object_tracking_by_using_depth.py"
    name="object_tracking_by_using_depth"
    output="screen">

    <!-- bridgeからのraw検出 -->
    <param name="mask_topic" value="/sam3/raw/mask" />
    <param name="object_list_topic" value="/sam3/raw/object_list" />

    <!-- HSR head RGB-D -->
    <param name="rgb_topic"
           value="/hsrb/head_rgbd_sensor/rgb/image_rect_color" />
    <param name="depth_topic"
           value="/hsrb/head_rgbd_sensor/depth_registered/image_rect_raw" />
    <param name="camera_info_topic"
           value="/hsrb/head_rgbd_sensor/rgb/camera_info" />
    <param name="switch_topic" value="/sam3/switch" />

    <!-- 追跡後の従来互換出力 -->
    <param name="tracked_mask_topic" value="/sam/mask" />
    <param name="tracked_overlay_topic" value="/sam/overlay" />
    <param name="tracked_centroid_topic" value="/sam3/mask/centroid" />
    <param name="tracked_object_list_topic" value="/sam3/object_list" />
    <param name="marker_topic" value="/sam3/depth_tracking/markers" />

    <!-- カメラやロボットが動いても同一物体を比較できる固定座標系 -->
    <param name="fixed_frame" value="odom" />

    <!-- depthが16UC1[mm]の場合 -->
    <param name="depth_scale" value="0.001" />
    <param name="min_depth" value="0.15" />
    <param name="max_depth" value="5.0" />
    <param name="mask_erode_px" value="2" />
    <param name="min_depth_pixels" value="20" />

    <!-- 3D対応付けと遮蔽保持 -->
    <param name="max_match_distance" value="0.35" />
    <param name="max_object_speed" value="0.30" />
    <param name="max_prediction_time" value="2.0" />
    <param name="max_missed_frames" value="30" />
    <param name="max_missed_seconds" value="3.0" />

    <!-- RGB/mask/object/depthの近似同期 -->
    <param name="sync_queue_size" value="10" />
    <param name="sync_slop" value="0.12" />
    <param name="tf_timeout" value="0.10" />
    <param name="allow_latest_tf" value="true" />
  </node>
</launch>
