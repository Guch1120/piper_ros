<!-- launch/drag_segment.launch -->
<launch>

  <!-- ノード1: GUI（カメラ画像表示・ドラッグ操作） -->
  <node
    pkg="sam3_bridge"
    type="drag_segment_gui.py"
    name="drag_segment_gui"
    output="screen">
    <param name="topic_name" value="/hsrb/head_rgbd_sensor/rgb/image_rect_color" />
  </node>

  <!-- ノード2: Bridge（bbox受信・gRPC送信・mask publish） -->
  <node
    pkg="sam3_bridge"
    type="drag_segment_bridge.py"
    name="drag_segment_bridge"
    output="screen">
    <param name="grpc_host"    value="localhost" />
    <param name="grpc_port"    value="50052" />
    <param name="grpc_timeout" value="10.0" />
    <param name="jpeg_quality" value="75" />
    <param name="max_width"    value="640" />
    <param name="max_height"   value="480" />
    <param name="topic_name"   value="/hsrb/head_rgbd_sensor/rgb/image_rect_color" />
  </node>

</launch>
