<?xml version="1.0"?>
<package format="3">
  <name>sam3_dual_ros</name>
  <version>0.0.0</version>
  <description>Separate SAM3 ROS wrapper package</description>
  <maintainer email="noreply@example.com">OpenAI</maintainer>
