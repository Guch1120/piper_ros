<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_description</name>
  <version>0.0.0</version>
  <description>
    Kobuki(台車) + カチャカシェルフ(棚, プレースホルダー形状) + Piper(6軸アーム+グリッパ) を
    合成したモバイルマニピュレータの URDF (xacro) 一式。
    棚・アームの取付位置/姿勢は placeholder であり、実機計測後に xacro property を調整する前提。
  </description>
  <maintainer email="taku.fcbarca.messi10@gmail.com">guch1120</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>kobuki_description</exec_depend>
  <exec_depend>piper_description</exec_depend>
  <exec_depend>kobuki_unity</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
