<robot name="mobile_manipulator">
  <!--
    ============================================================================
     Kobuki + カチャカシェルフ + Piper 合成モバイルマニピュレータ URDF (xacro)
    ============================================================================

     構成: base_footprint (Kobuki root)
             -> base_link (Kobuki 本体, kobuki_description の "kobuki" マクロ)
               -> kachaka_shelf_link (カチャカシェルフ, プレースホルダー形状の箱型近似)
                 -> kachaka_shelf_top_link (シェルフ上面の仮想マウントリンク, 質量ゼロ)
                   -> piper_base_link (Piper アーム, piper_description の piper_robot マクロ)

     *** 重要: このファイルの寸法・取付位置はすべて "実測前の placeholder" です ***
     - kachaka_shelf_* : シェルフの外形寸法はメーカー公表値(488x328x717mm, 8.8kg)を
       流用していますが、Kobuki 本体上のどこにどの姿勢で固定するか(x/y/z/roll/pitch/yaw)
       は未計測です。下の xacro:property セクションで一箇所にまとめてあるので、
       実機を計測したらここだけを書き換えてください。
     - piper_mount_* : シェルフ上面に対する Piper base_link の取付位置・姿勢も未計測の
       placeholder です。同様に下の property を実測値で更新してください。
     - Piper 側の既存 joint 名 (joint1..joint6, joint7/joint8, tcp_joint 等) および
       link 名は unity_urdf 連携や既存の制御設定との互換性のため変更していません。
       Kobuki と重複する "base_link" という名前だけ、Piper 側は
       piper_base_link にリネームして衝突を避けています。

     *** Docker 環境での実行について ***
     piper_ros と oit_kobuki_ws-main は別々の Docker コンテナ (piper-humble-dev /
     oit-kobuki-ws-ros2) で動作しており、ファイルシステムは共有していません。
     kobuki_description パッケージを piper-humble-dev コンテナ内から参照できるように、
     docker/docker-compose.yml の piper-humble-dev サービスに
       - ../../oit_kobuki_ws-main:/home/kobuki_ws:ro
     を追加しています(読み取り専用マウント)。このファイルを xacro 展開する際は、
     コンテナ内で以下の両方を source してください:
       source /ros2_ws/install/setup.bash              # piper_description, 本パッケージ等
       source /home/kobuki_ws/install/setup.bash        # kobuki_description (oit_kobuki_ws-main 側で事前ビルド済みのもの)
     docker-compose.yml のマウント設定は起動中のコンテナには反映されないため、
     反映するにはコンテナの再作成が必要です(具体的なコマンドは
     view_mobile_manipulator.launch.py 冒頭のコメントを参照)。
  -->
  <!-- ===================================================================== -->
  <link name="base_footprint"/>
  <!--
       Base link is set at the bottom of the base mould.
       This is done to be compatible with the way base link
       was configured for turtlebot 1. Refer to

       https://github.com/turtlebot/turtlebot/issues/40

       To put the base link at the more oft used wheel
       axis, set the z-distance from the base_footprint
       to 0.352.
      -->
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0102"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <!-- new mesh -->
        <mesh filename="package://kobuki_description/meshes/main_body.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.001 0 0.05199"/>
    </visual>
    <collision name="base">
      <geometry>
        <cylinder length="0.10938" radius="0.178"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0 0.05949"/>
    </collision>
    <inertial>
      <!-- COM experimentally determined -->
      <origin xyz="0.01 0 0"/>
      <mass value="2.4"/>
      <!-- 2.4/2.6 kg for small/big battery pack -->
      <!-- Kobuki's inertia tensor is approximated by a cylinder with homogeneous mass distribution
             More details http://en.wikipedia.org/wiki/List_of_moment_of_inertia_tensors
             m = 2.4 kg; h = 0.09 m; r = 0.175 m
             ixx = 1/12 * m * (3 * r^2 + h^2)
             iyy = 1/12 * m * (3 * r^2 + h^2)
             izz = 1/2 * m * r^2
          -->
      <inertia ixx="0.019995" ixy="0.0" ixz="0.0" iyy="0.019995" iyz="0.0" izz="0.03675"/>
    </inertial>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0.00 0.115 0.0250"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <mesh filename="package://kobuki_description/meshes/wheel.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.0206" radius="0.035"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="wheel_right_joint" type="continuous">
