<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_flexbe_behaviors</name>
  <version>0.0.0</version>
  <description>FlexBE behaviors and launch files for Piper robot</description>
  <maintainer email="todo@todo.com">user</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>flexbe_core</depend>
  <depend>flexbe_widget</depend>
  <depend>piper_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Dependencies for launch file -->
  <exec_depend>piper</exec_depend>
  <exec_depend>piper_with_gripper_moveit</exec_depend>
  <exec_depend>detic_onnx_ros2</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
