# Deticのインストール
[Deticによる物体検出とセグメンテーション](https://zenn.dev/kaeru39/articles/ed00244dbb32cd)


mkdir ./detic
git clone git@github.com:facebookresearch/detectron2.git
cd detectron2
pip install torch==2.4.1 torchvision

pip uninstall numpy
pip install numpy==1.22.2
pip uninstall scipy opencv-python
pip install scipy==1.11.4
pip install opencv-python==4.8.1.78

pip install -e .
pip list | grep numpy

cd ..
git clone https://github.com/facebookresearch/Detic.git --recurse-submodules
cd Detic
pip install -r requirements.txt


python3 demo.py --config-file configs/Detic_LCOCOI21k_CLIP_SwinB_896b32_4x_ft4x_max-size.yaml --input ./models/sample.JPG --output out.jpg --vocabulary lvis --opts MODEL.WEIGHTS models/Detic_LCOCOI21k_CLIP_SwinB_896b32_4x_ft4x_max-size.pth