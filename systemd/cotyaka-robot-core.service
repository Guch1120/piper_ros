[Unit]
Description=Cotyaka Robot Core
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/cotyaka/robot-core.env
ExecStart=/bin/bash -lc 'cd "$COTYAKA_REPO_DIR" && /bin/bash scripts/robot_core.sh up'
ExecStop=/bin/bash -lc 'cd "$COTYAKA_REPO_DIR" && /bin/bash scripts/robot_core.sh down'
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
