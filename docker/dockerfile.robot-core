FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    can-utils \
    curl \
    ethtool \
    git \
    gnupg \
    iproute2 \
    lsb-release \
    net-tools \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    ros-humble-controller-manager \
    ros-humble-moveit \
    ros-humble-moveit-configs-utils \
    ros-humble-realsense2-description \
    ros-humble-robot-state-publisher \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-xacro \
    && rm -rf /var/lib/apt/lists/*

# RealSense (librealsense2 SDK + ROS 2 wrapper)
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://librealsense.realsenseai.com/Debian/librealsenseai.asc \
       | gpg --dearmor \
       | tee /etc/apt/keyrings/librealsenseai.gpg > /dev/null \
    && chmod 644 /etc/apt/keyrings/librealsenseai.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/librealsenseai.gpg] https://librealsense.realsenseai.com/Debian/apt-repo $(lsb_release -cs) main" \
       | tee /etc/apt/sources.list.d/librealsense.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends \
       librealsense2-utils \
       librealsense2-dev \
       librealsense2-dbg \
       ros-humble-realsense2-camera \
       ros-humble-realsense2-camera-msgs \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    python-can \
    scipy==1.11.4 \
    piper_sdk \
    pyrealsense2

RUN mkdir -p /ros2_ws/src
WORKDIR /ros2_ws

RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc
RUN git config --global --add safe.directory /ros2_ws

CMD ["sleep", "infinity"]
